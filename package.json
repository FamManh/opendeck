{
  "name": "opendeck",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait db",
    "dev:backend": "pnpm --filter @opendeck/backend dev",
    "dev:frontend": "pnpm --filter @opendeck/frontend dev"
  }
}
